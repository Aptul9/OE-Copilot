# Ambiente Python e build
.venv/
__pycache__/
*.pyc
build/
dist/

# Dati di chi usa l'app: restano sul server (ui-dati/) o sul PC di chi prova in locale, mai nel repository
personalizzazione.json
personalizzazione.*.json
!personalizzazione.esempio.json
config.json
*.rotto-*
calendars_cache.json
events_cache.json
fired_reminders.json
local_events.json
teams_tenants.json
agente_chiave.bin
agente_caselle.json
ics_cache/
.tmp_*

# Log
*.log
*.log.*

# Estensioni personali dell'app per Windows ritirata (codice scritto per una persona sola): mai nel repository
personale/
web/personale/

# Loghi delle aziende di chi usa l'app: resta solo l'icona generica
web/logos/*
!web/logos/personale.png

# APK delle app del telefono: stanno fra i file della release "apk", non nel repository
server/apk/*.apk

# server/ui/app/: copia dei moduli dell'app e dei suoi loghi, la rifa server/strumenti/prepara_ui.sh
server/ui/app/

# Dati e segreti del server: restano sul server (GUIDA.md, sezioni 4.2 e 4.7), mai nel repository
server/.env
server/agent/fonti.json
server/ui-dati/
server/telefono/
server/stato/
