# Ambiente Python e build
.venv/
__pycache__/
*.pyc
build/
dist/

# Dati di chi usa l'app: restano sul server (ui-dati/) o sul PC di chi prova in locale, mai nel repository
personalizzazione.json
personalizzazione.*.json
!personalizzazione.esempio.json
config.json
*.rotto-*
calendars_cache.json
events_cache.json
fired_reminders.json
local_events.json
teams_tenants.json
agente_chiave.bin
agente_caselle.json
ics_cache/
.tmp_*

# Log
*.log
*.log.*

# Estensioni personali dell'app per Windows ritirata (codice scritto per una persona sola): mai nel repository
personale/
web/personale/

# Loghi delle aziende di chi usa l'app: nella cartella dell'immagine resta solo personale.png, l'icona degli eventi personali
server/web-ts/logos-predefiniti/*
!server/web-ts/logos-predefiniti/personale.png

# APK delle app del telefono: stanno fra i file della release "apk", non nel repository
server/apk/*.apk

# Dati e segreti del server: restano sul server (GUIDA.md, sezioni 4.2 e 4.7), mai nel repository
server/.env
server/agent/fonti.json
server/ui-dati/
server/telefono/
server/stato/

# Client desktop (app/): dipendenze, risultato della build, configurazione locale con l'indirizzo del sito, chiavi di firma
app/node_modules/
app/src-tauri/target/
app/src-tauri/gen/schemas/
app/src-tauri/permissions/autogenerated/
app/src-tauri/tauri.conf.local.json
app/src-tauri/gen/android/.gradle/
app/src-tauri/gen/android/**/build/
*.keystore
*.jks
