API_KEY=
# Interfaccia web (facoltativa, README.md 4.7): indirizzo del sito.
UI_HOST=
# Nome a parte per la disponibilità pubblica (facoltativo, README.md 4.7): la sua radice è /disponibilita, e il resto del sito lì non c'è.
# MEET_HOST=
# Accesso: il proprietario nasce a ogni avvio del gateway da ADMIN_EMAIL e ADMIN_PASSWORD (almeno 12 caratteri, senza $); una password nuova
# qui chiude le sessioni aperte.
# Con l'aggiornamento automatico (README.md 4.6) ADMIN_EMAIL, ADMIN_PASSWORD, API_KEY e BETTER_AUTH_SECRET arrivano dai
# secret della Action e qui restano vuote.
# BETTER_AUTH_SECRET firma i cookie di sessione: almeno 32 caratteri (openssl rand -hex 32).
ADMIN_EMAIL=
ADMIN_PASSWORD=
BETTER_AUTH_SECRET=
# Secondo fattore dell'accesso (README.md 4.7): off (predefinito), totp (il codice di un'app di autenticazione e i codici
# di recupero) o passkey (anche le passkey). Un altro valore ferma l'avvio del gateway. Per rientrare con la sola password:
# AUTH_2FA=off e ricreare il gateway.
AUTH_2FA=off
# Notifiche del browser (facoltative, README.md 4.9): la coppia di chiavi VAPID (il comando per farla è nel README) e un contatto,
# mailto:<indirizzo> o https://<sito>. Senza i tre valori non partono. Dopo averli messi un nuovo aggiornamento ricrea il gateway
# (README.md 4.7, sui secret): un riavvio semplice non rilegge .env.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# Ogni quanti secondi il server cerca le riunioni in arrivo (da 5 a 3600, di norma 30).
# PROMEMORIA_INTERVALLO_S=
# EverID (facoltativo, README.md 4.7): EVERID_UPSTREAM è l'outpost di Authentik (host:porta) per il forward_auth di Caddy davanti
# all'interfaccia; meet, /mcp, /condividi/ e /salute restano fuori. EVERID=on fa entrare nel gateway l'utente con l'email che EverID
# passa (solo da Caddy, EVERID_PROXY). ACCESSO_PASSWORD=off toglie l'accesso con la password quando EverID funziona.
# EVERID_UPSTREAM=
# EVERID=off
# ACCESSO_PASSWORD=on
