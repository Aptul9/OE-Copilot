{
  "name": "oe-copilot-supervisore",
  "version": "0.1.0",
  "description": "Supervisore del telefono virtuale di OE Copilot: tiene aggiornati i calendari con adb, scrive il battito e rileva gli accessi scaduti",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "3.3.9"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
