# Remote MCP (compose.yml). Copy to .env, chmod 600. Never commit the filled file.

# Clients send Authorization: Bearer <MCP_HTTP_TOKEN>. At least 32 characters: openssl rand -hex 32
MCP_HTTP_TOKEN=
# Host headers accepted on /mcp: the public name (the TeamsRelay one when proxied on /communication), plus 127.0.0.1:8190
# for checks through an SSH tunnel
MCP_HTTP_HOSTS=teams.example.com,127.0.0.1:8190

# Mail and calendars: the OE Copilot token broker; Gmail and Google Chat go to the agent at the same address
OUTLOOK_MCP_BROKER_URL=http://agent:8180/api/token-posta
# API_KEY of the OE Copilot agent
OUTLOOK_MCP_BROKER_KEY=

# Teams: TeamsRelay /mcp and its MCP_TOKEN. Empty URL = no Teams accounts.
OUTLOOK_MCP_TEAMS_URL=http://webapp:8090/mcp
OUTLOOK_MCP_TEAMS_TOKEN=

# Slack: the slackcli workspace store (the image sets /slackcli/workspaces.json, mounted by compose.yml). Unset = no Slack.
# SLACK_WORKSPACES=/slackcli/workspaces.json
# Production compose derives the resource handle key from MCP_HTTP_TOKEN; without a key, handles die with the process.
# COMMUNICATION_ID_KEY=
