API_KEY=
# Interfaccia web (facoltativa, GUIDA.md 4.7): indirizzo del sito.
UI_HOST=
# Accesso: il proprietario nasce da ADMIN_EMAIL e ADMIN_PASSWORD (almeno 12 caratteri, senza $).
# Con l'aggiornamento automatico (GUIDA.md 4.6) ADMIN_EMAIL, ADMIN_PASSWORD, API_KEY e BETTER_AUTH_SECRET arrivano dai
# secret della Action e qui restano vuote.
# a ogni avvio del gateway; una password nuova qui chiude le sessioni aperte.
# BETTER_AUTH_SECRET firma i cookie di sessione: almeno 32 caratteri (openssl rand -hex 32).
ADMIN_EMAIL=
ADMIN_PASSWORD=
BETTER_AUTH_SECRET=
# Secondo fattore dell'accesso (GUIDA.md 4.7): off (predefinito), totp (il codice di un'app di autenticazione e i codici
# di recupero) o passkey (anche le passkey). Un altro valore ferma l'avvio del gateway. Per rientrare con la sola password:
# AUTH_2FA=off e ricreare il gateway.
AUTH_2FA=off
# Promemoria dal server (facoltativi, GUIDA.md 4.9). Senza i primi due il canale Telegram non è configurato:
# TELEGRAM_BOT_TOKEN è il token che BotFather dà al bot, TELEGRAM_CHAT_ID l'id della chat a cui scrive.
# Dopo averli messi: sudo docker compose up -d gateway (un riavvio semplice non rilegge .env).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Ogni quanti secondi il server cerca le riunioni in arrivo (da 5 a 3600, di norma 30).
# PROMEMORIA_INTERVALLO_S=
# Notifiche del browser (facoltative, GUIDA.md 4.9): la coppia di chiavi VAPID (il comando per farla è nella guida) e un contatto,
# mailto:<indirizzo> o https://<sito>. Senza i tre valori il canale non è configurato.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
