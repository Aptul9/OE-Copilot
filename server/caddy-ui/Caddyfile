# HTTPS davanti al gateway dell'interfaccia web, che chiede l'accesso (pagina /login). L'indirizzo
# arriva da .env (UI_HOST): non sta nel repository.
#
# Sulla VM la porta 443 è di sslh, che gira il TLS per nome (SNI) a questo Caddy sulla
# 4445 del localhost, e la porta 80 è di un altro Caddy: il certificato arriva col
# TLS-ALPN, passando da sslh. Il tentativo HTTP-01 fallisce prima: è previsto.
{
	# Caddy non scrive un log di accesso, ma un errore di inoltro (gateway fermo o in riavvio: 502) scrive la richiesta intera, indirizzo e intestazioni
	# comprese, e /condividi/<testo segreto>.ics (README.md, 4.10) ha il testo segreto nell'indirizzo (e in Referer, se la richiesta parte da lì): nei log
	# resta un nome fisso. Il filtro non dipende da come è scritto il percorso (//condividi/, /x/../condividi/, /CONDIVIDI/, l'indirizzo intero di una
	# richiesta fatta a un proxy): da /condividi/ in poi, fino al punto interrogativo, è tutto testo segreto; e dove che sia, una sequenza di 32 o più
	# caratteri base64url, com'è fatto il testo segreto (43). Le intestazioni non si scrivono.
	log {
		format filter {
			request>uri regexp (?i)/condividi/[^?]*|[A-Za-z0-9_-]{32,} /condividi/REDATTO
			request>headers delete
		}
	}
	servers {
		# UDP non è pubblicato: niente HTTP/3 da annunciare ai browser
		protocols h1 h2
	}
}

{$UI_HOST} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# Schermo del telefono (servizio schermo, README.md 4.8): il servizio non ha password e comanda il telefono, quindi
	# ogni richiesta, il WebSocket compreso, chiede prima al gateway se c'è una sessione valida (204 sì, 302 verso
	# l'accesso per una pagina, 401 per il resto). Un WebSocket parte solo dalla pagina di questo sito (Origin).
	redir /telefono /telefono/ 308
	handle /telefono/* {
		# route: l'ordine qui sotto è quello scritto (senza, Caddy metterebbe il rifiuto dopo l'inoltro e non scatterebbe mai)
		route {
			@altro_sito {
				header Connection *Upgrade*
				not header Origin {scheme}://{hostport}
			}
			respond @altro_sito "origine non ammessa" 403
			forward_auth gateway:3000 {
				uri /api/verifica-sessione
				# la domanda al gateway è una richiesta normale, anche quando quella del browser è un WebSocket
				header_up -Connection
				header_up -Upgrade
			}
			uri strip_prefix /telefono
			reverse_proxy schermo:8000
		}
	}

	handle {
		reverse_proxy gateway:3000
	}
}
