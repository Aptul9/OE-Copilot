{
  "name": "oe-copilot-schermo-web",
  "version": "0.9.0-dev",
  "description": "Schermo del telefono virtuale di OE Copilot nel browser (ws-scrcpy, potato e aggiornato)",
  "scripts": {
    "dist": "webpack --config webpack.config.cjs",
    "start": "npm run dist && cd dist && npm start",
    "script:dist:start": "node ./index.js",
    "smoke": "node scripts/smoke.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/pausa.test.mjs"
  },
  "author": "Sergey Volkov <drauggres@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@devicefarmer/adbkit": "3.3.9",
    "express": "5.3.0",
    "portfinder": "1.0.38",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@dead50f7/generate-package-json-webpack-plugin": "2.6.1",
    "@types/bluebird": "3.5.42",
    "@types/dom-webcodecs": "0.1.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.2",
    "buffer": "6.0.3",
    "css-loader": "7.1.5",
    "file-loader": "6.2.0",
    "h264-converter": "0.1.4",
    "html-webpack-plugin": "5.6.8",
    "ifdef-loader": "2.3.2",
    "mini-css-extract-plugin": "2.10.2",
    "path-browserify": "1.0.1",
    "svg-inline-loader": "0.8.2",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-node-externals": "3.0.0"
  },
  "private": true
}
