# TeamsRelay configuration. Copy to .env and fill in:   cp .env.example .env
# .env holds secrets: never commit it (it is in .gitignore). Reference: docs/configuration.md

# Public name of the server; its DNS record points to the server and Caddy gets the certificate for it
DOMAIN=teams.example.com

# Key that signs the web app sessions, at least 32 characters:   openssl rand -hex 32
# Changing it signs every user out.
BETTER_AUTH_SECRET=

# First administrator, created at the first start while the server has no users
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MCP endpoint /mcp for AI clients (Claude Code, opencode...), acting as ADMIN_EMAIL: reads, sends, edits and
# deletes messages of that user's Teams accounts.
# Empty: off. Otherwise at least 32 characters:   openssl rand -hex 32
MCP_TOKEN=

# Teams accounts of the server, each one a browser with its agent in the browsers container.
# ACCOUNTS_PER_USER empty means no cap: the memory of the server is the only limit.
ACCOUNTS_PER_USER=

# Remote desktop: keep DESKTOP_PASS empty, it is behind the web app login (users with a Teams account only).
DESKTOP_USER=
DESKTOP_PASS=
# Address of the desktop of account {n}. Empty: /api/desktop/{n} on DOMAIN, which brings the window of the
# account to the front of the one desktop, /desktop/.
DESKTOP_URL=

# Contact required by the Web Push standard (VAPID)
VAPID_SUBJECT=mailto:admin@example.com

# Time zone of the automatic checks (8-11 and 17-20)
TZ=Europe/Rome

# HTTPS port and bind address of Caddy
HTTPS_PORT=443
HTTPS_BIND=0.0.0.0

# Optional: shared Microsoft accounts of the OE calendar agent on the same host. Each account is signed in once in the
# calendar; with Teams on (Settings here, or the Account window of the calendar) a Teams account runs on it without a
# browser. URL and key both or none.
#   SHARED_BROKER_URL      address of the calendar agent from the browsers container: http://oe-copilot-agent:8180
#   SHARED_BROKER_KEY      the agent's TEAMS_BROKER_KEY (its narrow key: account list and chat tokens only)
#   SHARED_ACCOUNTS_OWNER  the user the accounts belong to; empty: ADMIN_EMAIL
#   SHARED_ACCOUNTS_URL    where a new account is signed in, the calendar: https://calendar.example.com
SHARED_BROKER_URL=
SHARED_BROKER_KEY=
SHARED_ACCOUNTS_OWNER=
SHARED_ACCOUNTS_URL=

# Optional: EverID (Authentik) sign-in in front of the pages and the remote desktop. Caddy sends them through the outpost
# of the proxy provider of this app; the API, /mcp, the relays, the service worker and the push endpoints stay outside.
#   EVERID_MODE      off (default) or on
#   EVERID_OUTPOST   the outpost as the Caddy container reaches it
#   EVERID_GROUP     the EverID group that may sign in: app-teams by default
#   EVERID_ALIASES   everid-email=local-email pairs, comma separated, for a user whose EverID address differs from the one here
#   PASSWORD_LOGIN   0 turns the password sign-in off while EverID is on; with EverID off it always works
EVERID_MODE=off
EVERID_OUTPOST=http://172.17.0.1:9000
EVERID_GROUP=
EVERID_ALIASES=
PASSWORD_LOGIN=
# Optional: notifications through ntfy as well
NTFY_ENABLED=0
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
