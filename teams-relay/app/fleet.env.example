# TeamsRelay fleet agent (npm run fleet:agent, or npx pm2 start ecosystem.config.cjs).
# Copy to fleet.env (never in git). Takes precedence over fleet.config.json when FLEET_VM is set.

# Start teamsrelay-fleet alongside the relay under pm2 (any non-empty value; leave empty for standalone runs).
FLEET_AGENT=1

# Hub VM ssh alias (an entry in ~/.ssh/config).
FLEET_VM=oracle-vm
# Run a second agent on this host: shifts local ports we bind by N (0 = bases below).
FLEET_INSTANCE=0

# Command API (1 = enabled, 0 = off).
FLEET_CMDAPI=0
FLEET_CMDAPI_VM_PORT=8766
FLEET_CMDAPI_VM_SPAN=6
FLEET_CMDAPI_LOCAL_PORT=8765
# Per-host token (>= 16 chars): node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
FLEET_CMDAPI_TOKEN=
FLEET_CMDAPI_CWD=
FLEET_CMDAPI_TIMEOUT=600

# SSH server and reverse tunnel (1 = enabled, 0 = off).
# library = embedded ssh2 server (shell, exec, sftp, direct-tcpip); system = this host's own sshd (:22).
FLEET_SSH=1
FLEET_SSH_MODE=library
FLEET_SSH_VM_PORT=8822
FLEET_SSH_VM_SPAN=1
FLEET_SSH_LOCAL_PORT=2022
FLEET_SSH_HOST_KEY=state/fleet/ssh_host_key
# OpenSSH public key(s) allowed to log in (library mode): inline key (multiple separated by ;), and/or file path.
FLEET_SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA...your public key... you@laptop
FLEET_SSH_AUTHORIZED_KEYS_FILE=
