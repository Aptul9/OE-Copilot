# TeamsRelay: Caddy with automatic HTTPS. DOMAIN and HTTPS_PORT come from .env through docker-compose.yml.
{
	http_port 80
	https_port {$HTTPS_PORT:443}
}

# EverID sign-in in front of the pages: everid/off.caddy or everid/on.caddy, by EVERID_MODE (.env). Any other value is
# refused by deploy/render-env.sh and by the Caddyfile check of remote-deploy.sh before this Caddy restarts.
import everid/{$EVERID_MODE:off}.caddy

{$DOMAIN} {
	# who is signed in to EverID comes only from its outpost (everid_gate): the same headers sent by a client are dropped
	# before any handle runs (request_header comes before handle in Caddy's order)
	request_header -X-Authentik-*
	import everid_routes
	# the pages of the web app, the only paths where it reads X-Authentik-Email
	@pages path / /admin /settings /remote /login
	handle @pages {
		import everid_gate
		encode zstd gzip
		reverse_proxy webapp:8090
	}
	# Remote desktop of the browsers container on /desktop/: the browser window of every Teams account.
	# Caddy asks the web app whether the session cookie belongs to a user with an account before letting a
	# request through.
	redir /desktop /desktop/ 302
	# desktop of one account, the address of the releases with one desktop per account
	@deskslot path_regexp deskslot ^/desktop/([0-9]+)/?$
	redir @deskslot /api/desktop/{re.deskslot.1} 302
	handle /desktop/* {
		import everid_gate
		forward_auth webapp:8090 {
			uri /api/authcheck
			# the check is a plain HTTP request even when the original one is a websocket (the desktop
			# stream): with Upgrade the web app would answer 403
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy browsers:3000
	}
	# Remote MCP of mail, calendars and Teams (repo Aptul9/Outlook-MCP, ts/compose.yml) at /communication/mcp, when a
	# container named communication-mcp runs on this compose network; without it this path alone answers 502
	handle_path /communication/* {
		reverse_proxy communication-mcp:8190
	}
	handle {
		# the web app sends its pages and the scripts of the UI as they are: zstd or gzip here, 1.3 MiB down to 0.4
		encode zstd gzip
		reverse_proxy webapp:8090
	}
	# the desktop is off while no browser runs: a direct visit lands on the page that starts it
	handle_errors {
		@desktopdown {
			path /desktop/*
			expression {err.status_code} in [502, 503, 504]
		}
		redir @desktopdown /remote 302
	}
}
